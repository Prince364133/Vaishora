# ---------------------------------------------------------------------------
# VAISHORA environment variables. Copy to .env.local (dev) or set in your host.
# ---------------------------------------------------------------------------

# Public site URL (used for metadata and links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 32+ random characters. Signs customer booking links. REQUIRED in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# --- Database --------------------------------------------------------------
# Leave empty for local development: an embedded PGlite database is created in .data/pglite.
# Production: PostgreSQL connection string (Supabase → Project Settings → Database → connection string,
# use the session pooler on port 5432 or a direct connection; transaction pooler also works).
DATABASE_URL=
# DATABASE_SSL=false            # only for local Postgres without TLS
# DATABASE_POOL_MAX=5
# DATABASE_AUTO_MIGRATE=false   # set true to apply migrations on first request (prefer `pnpm db:migrate`)
# PGLITE_DIR=.data/pglite       # local DB location (use memory:// for throwaway)

# --- Admin bootstrap (used by `pnpm db:seed`) -------------------------------
ADMIN_EMAIL=admin@vaishora.local
ADMIN_PASSWORD=

# --- 180 Core (180 Identity sign-in + 180 Pay checkout) ----------------------
# See docs/integrations/180CORE.md. The secret is server-only.
NEXT_PUBLIC_CORE_CLIENT_ID=
ONE_EIGHTY_CLIENT_ID=
ONE_EIGHTY_CLIENT_SECRET=
# Webhook signing secret (whsec_...) from the 180 portal -> 180 Pay -> Overview & Webhook
ONE_EIGHTY_WEBHOOK_SECRET=
# "off" = guest checkout (name/phone/email/gender/address) instead of the 180 sign-in sheet.
# Keep "off" until 180 Identity is enabled for the app in the 180 developer portal.
NEXT_PUBLIC_180_IDENTITY=off

# --- Payments ----------------------------------------------------------------
# 180pay | razorpay | mock (development only — ignored when NODE_ENV=production) | empty = payments disabled
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate secret configured on the Razorpay webhook (Dashboard → Settings → Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# --- File storage (admin uploads) -------------------------------------------
# Supabase Storage. Create a PUBLIC bucket (default name below). Without these, uploads go to
# public/uploads, which is refused in production unless ALLOW_LOCAL_UPLOADS=1 (persistent disk only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=public-assets
# ALLOW_LOCAL_UPLOADS=1

# --- Public contact links (override admin settings) ------------------------
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
